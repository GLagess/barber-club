generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  BARBER_FIXED
  BARBER_MOBILE
  CUSTOMER
}

enum BarbershopStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum LinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedBarbershop    Barbershop?          @relation("Owner")
  barberLinks        BarberLink[]
  appointments       Appointment[]        @relation("ClientAppointments")
  barberAppointments Appointment[]        @relation("BarberAppointments")
  mobileSettings     MobileBarberSettings?
  reviewsGiven       Review[]             @relation("ClientReviews")
  reviewsReceived    Review[]             @relation("BarberReviews")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id          String           @id @default(cuid())
  ownerId     String           @unique
  owner       User             @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  cnpj        String           @unique
  status      BarbershopStatus @default(PENDING_APPROVAL)
  address     String
  city        String
  state       String
  phone       String
  description String?
  logoUrl     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  barberLinks  BarberLink[]
  services     Service[]
  appointments Appointment[]
  workingHours WorkingHours[]
  reviews      Review[]

  @@map("barbershops")
}

model BarberLink {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barberId     String
  barber       User       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  status       LinkStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([barbershopId, barberId])
  @@map("barber_links")
}

model Service {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  durationMin  Int
  price        Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  appointments Appointment[]

  @@map("services")
}

model WorkingHours {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isOpen       Boolean    @default(true)

  @@unique([barbershopId, dayOfWeek])
  @@map("working_hours")
}

model Appointment {
  id            String            @id @default(cuid())
  barbershopId  String?
  barbershop    Barbershop?       @relation(fields: [barbershopId], references: [id])
  clientId      String
  client        User              @relation("ClientAppointments", fields: [clientId], references: [id])
  barberId      String
  barber        User              @relation("BarberAppointments", fields: [barberId], references: [id])
  serviceId     String
  service       Service           @relation(fields: [serviceId], references: [id])
  scheduledAt   DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(CONFIRMED)
  notes         String?
  isHomeService Boolean           @default(false)
  address       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  review Review?

  @@map("appointments")
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        User        @relation("ClientReviews", fields: [clientId], references: [id])
  barberId      String
  barber        User        @relation("BarberReviews", fields: [barberId], references: [id])
  barbershopId  String?
  barbershop    Barbershop? @relation(fields: [barbershopId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@map("reviews")
}

model MobileBarberSettings {
  id             String  @id @default(cuid())
  barberId       String  @unique
  barber         User    @relation(fields: [barberId], references: [id], onDelete: Cascade)
  radiusKm       Float   @default(10)
  deliveryFeeMin Decimal @db.Decimal(10, 2) @default(0)
  bufferMinutes  Int     @default(30)
  lat            Float?
  lng            Float?
  city           String?

  @@map("mobile_barber_settings")
}
